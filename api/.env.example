NODE_ENV=development
PORT=3000
WORKFORCE_SERVICE_HOST=localhost
WORKFORCE_SERVICE_PORT=4001

# JWT imzalama anahtarı (en az 32 karakter). Üretmek için: openssl rand -hex 32
JWT_SECRET=buraya-en-az-32-karakterlik-gizli-bir-deger-yazin
JWT_EXPIRES_IN=1h
# Bildirim okuma (notification-service TCP portu)
NOTIFICATION_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_PORT=4002

NODE_ENV=development

# Bildirim listeleme için TCP portu (api'deki NOTIFICATION_SERVICE_PORT ile aynı olmalı). HTTP portu açılmaz.
PORT=4002

# PostgreSQL (docker-compose.yaml ile aynı değerler). Tablolar ayrı "notification" şemasında tutulur.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=mini_wfm

# RabbitMQ (docker-compose.yaml ile aynı kullanıcı/parola)
RABBITMQ_URL=amqp://wfm:wfm@localhost:5672
# workforce-service'teki RABBITMQ_QUEUE ile aynı olmalı
RABBITMQ_QUEUE=notification_events
RABBITMQ_PREFETCH=10

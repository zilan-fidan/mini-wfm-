NODE_ENV=development

# workforce-service'in dinlediği TCP portu (api'deki WORKFORCE_SERVICE_PORT ile aynı olmalı)
PORT=4001

# PostgreSQL (docker-compose.yaml ile aynı değerler)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=mini_wfm

# RabbitMQ (docker-compose.yaml ile aynı kullanıcı/parola). Kapalıyken de servis çalışır; olay yayınlanamazsa loglanır.
RABBITMQ_URL=amqp://wfm:wfm@localhost:5672
# notification-service'teki RABBITMQ_QUEUE ile aynı olmalı
RABBITMQ_QUEUE=notification_events
RABBITMQ_PUBLISH_TIMEOUT_MS=3000

# Geciken iş emri kontrolünün aralığı (cron). Varsayılan her 15 dakika; geliştirmede "* * * * *" = her dakika.
OVERDUE_CHECK_CRON=*/15 * * * *
